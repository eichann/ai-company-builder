#!/usr/bin/env bash
# model/drive-view/check: run the Drive video viewing model (DriveView.tla: the view pick and the streaming of its
# bytes) through the checker tla-ts. The one entry point, locally and in CI (job "Model (Drive view)"). Needs bash,
# Node and npm only. The same structure as model/browser-plan/check:
#   1. The real model keeps every INVARIANT and has no dead end (a finished run stutters in `Done`); the rules it checks
#      are exactly expected.txt's `rule DriveView` lines (dropping one fails); a CHECK_DEADLOCK line is refused.
#   2. Its distinct state count equals expected.txt's `states DriveView` (a guard against a checker that explores less).
#   3. Each broken variant (broken/) fails on exactly the rule expected.txt names. A variant that passes fails this
#      script: the checker must not wave through something known to be broken.
#   Every variant file has a line in expected.txt and every line has its file.
# The checker is installed from package-lock.json into a temporary folder (no install scripts run); nothing is written
# to the repository or to HOME.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
fail() { echo "FAIL $*" >&2; exit 1; }
started=$(date +%s)

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
export TMPDIR="$tmp"
command -v node >/dev/null || fail "node not found"
command -v npm >/dev/null || fail "npm not found"
mkdir -p "$tmp/npm" "$tmp/run"
cp "$here/package.json" "$here/package-lock.json" "$tmp/npm/"
(cd "$tmp/npm" && npm_config_cache="$tmp/npm-cache" npm_config_update_notifier=false \
  npm ci --ignore-scripts --no-audit --no-fund --loglevel=error >/dev/null) || fail "cannot install the checker (npm ci)"
checker=(node "$tmp/npm/node_modules/tla-ts/dist/cli.js")
echo "checker: tla-ts $(node -p "require('$tmp/npm/node_modules/tla-ts/package.json').version") (Node $(node --version))"

cp "$here"/*.tla "$here"/*.cfg "$tmp/run/"
for f in "$here/broken"/*.tla "$here/broken"/*.cfg; do [ -e "$f" ] && cp "$f" "$tmp/run/"; done

run() { # run <module> → $tmp/out, $code
  code=0
  local m=$1
  rm -rf "$tmp/states"
  (cd "$tmp/run" && "${checker[@]}" -config "$m.cfg" -workers 1 -metadir "$tmp/states" "$m.tla") >"$tmp/out" 2>&1 || code=$?
}
show() { sed 's/^/     | /' "$tmp/out" | tail -40 >&2; }
violated() { sed -n 's/.*Invariant \([A-Za-z0-9_]*\) is violated.*/\1/p' "$tmp/out" | head -1; }
states_found() { grep -oE '[0-9,]+ distinct states found' "$tmp/out" | tail -1 | cut -d' ' -f1 | tr -d ,; }
passed() { [ "$code" -eq 0 ] && grep -q "No error has been found" "$tmp/out"; }

# Every variant file is listed in expected.txt, and every listed variant has its file.
for f in "$here/broken"/*.tla; do
  [ -e "$f" ] || continue
  m=$(basename "$f" .tla)
  awk -v m="$m" '$1 == "broken" && $2 == m { found = 1 } END { exit !found }' "$here/expected.txt" || fail "broken/$m.tla has no line in expected.txt (a variant nobody runs)"
  [ -e "$here/broken/$m.cfg" ] || fail "broken/$m.tla has no $m.cfg"
done
while read -r kind module _; do
  [ "$kind" = broken ] || continue
  [ -e "$here/broken/$module.tla" ] || fail "expected.txt names broken $module but broken/$module.tla is missing"
done <"$here/expected.txt"

# 1, 2: the real model
model=DriveView
[ "$(awk '$1 == "model" { print $2 }' "$here/expected.txt")" = "$model" ] || fail "expected.txt's model line is not $model"
! grep -qE '^[[:space:]]*CHECK_DEADLOCK' "$here/$model.cfg" || fail "$model.cfg has a CHECK_DEADLOCK line (dead ends must stay checked)"
have=$(sed -n 's/^INVARIANT //p' "$here/$model.cfg" | tr ' ' '\n' | sed '/^$/d' | sort)
need=$(awk -v m="$model" '$1 == "rule" && $2 == m { print $3 }' "$here/expected.txt" | sort)
[ "$have" = "$need" ] || fail "the rules $model.cfg checks differ from expected.txt's rule lines"
run "$model"
passed || { show; fail "the real model $model breaks a rule or has a dead end (exit code ${code})"; }
got=$(states_found)
want=$(awk -v m="$model" '$1 == "states" && $2 == m { print $3 }' "$here/expected.txt")
[ "$got" = "$want" ] || fail "the real model $model has $got distinct states, expected.txt says $want (changed the model? update expected.txt and say why in the PR)"
echo "ok   real model $model: keeps all $(wc -l <<<"$have" | tr -d ' ') INVARIANTs, no dead end, ${got} distinct states (as expected)"

# 3: broken variants must fail on their named rule
n=0
while read -r kind module rule; do
  [ "$kind" = broken ] || continue
  n=$((n + 1))
  run "$module"
  broke=$(violated)
  { [ "$code" -eq 12 ] && [ "$broke" = "$rule" ]; } || { show; fail "broken $module does not fail on $rule (exit code ${code}, rule broken: ${broke:-none})"; }
  echo "ok   broken $module fails $rule"
done <"$here/expected.txt"
[ "$n" -gt 0 ] || fail "expected.txt has no broken line"
echo "ok   model/drive-view/check: all passed in $(( $(date +%s) - started )) s"
