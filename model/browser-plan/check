#!/usr/bin/env bash
# model/browser-plan/check: run the browser plan lifecycle models (PlanLife.tla: today's one-write code;
# StepsLife.tla: the several-writes design) through the checker tla-ts.
# The one entry point, locally and in CI (job "Model (browser plan)"). Needs bash, Node and npm only.
#   1. Each real model keeps every INVARIANT and has no dead end; the rules it checks are exactly
#      expected.txt's `rule <model>` lines (dropping one fails); a CHECK_DEADLOCK line is refused; the
#      models run are exactly expected.txt's `model` lines.
#   2. Its distinct state count equals expected.txt's `states <model>` (a guard against a checker that
#      explores less).
#   3. R7 (every state can reach a settled one) holds on each state graph (reach.mjs), over every state.
#   4. Each broken variant (broken/) fails on exactly the rule expected.txt names (an R7 variant keeps every
#      INVARIANT and fails R7). A variant that passes fails this script: the checker must not wave through
#      something known to be broken.
#   5. Each accepted limit (limits/) and each open hole of today's code (holes/) fails on its named rule, so
#      neither disappears nor changes unnoticed.
#   6. Each proposed fix (proposals/) keeps every rule, R7 included, with its expected state count.
#   Every variant file has a line in expected.txt and every line has its file.
# The checker is installed from package-lock.json into a temporary folder (no install scripts run); nothing
# is written to the repository or to HOME.
set -euo pipefail
here=$(cd "$(dirname "$0")" && pwd)
fail() { echo "FAIL $*" >&2; exit 1; }
started=$(date +%s)

tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
export TMPDIR="$tmp"
command -v node >/dev/null || fail "node not found"
command -v npm >/dev/null || fail "npm not found"
mkdir -p "$tmp/npm" "$tmp/run"
cp "$here/package.json" "$here/package-lock.json" "$tmp/npm/"
(cd "$tmp/npm" && npm_config_cache="$tmp/npm-cache" npm_config_update_notifier=false \
  npm ci --ignore-scripts --no-audit --no-fund --loglevel=error >/dev/null) || fail "cannot install the checker (npm ci)"
checker=(node "$tmp/npm/node_modules/tla-ts/dist/cli.js")
echo "checker: tla-ts $(node -p "require('$tmp/npm/node_modules/tla-ts/package.json').version") (Node $(node --version))"

variants=(broken limits holes proposals)
cp "$here"/*.tla "$here"/*.cfg "$tmp/run/"
for d in "${variants[@]}"; do
  for f in "$here/$d"/*.tla "$here/$d"/*.cfg; do [ -e "$f" ] && cp "$f" "$tmp/run/"; done
done

run() { # run <module> [flags…] → $tmp/out, $code
  code=0
  local m=$1; shift
  (cd "$tmp/run" && "${checker[@]}" -config "$m.cfg" -workers 1 -metadir "$tmp/states" "$@" "$m.tla") >"$tmp/out" 2>&1 || code=$?
}
show() { sed 's/^/     | /' "$tmp/out" | tail -40 >&2; }
violated() { sed -n 's/.*Invariant \([A-Za-z0-9_]*\) is violated.*/\1/p' "$tmp/out" | head -1; }
states_found() { grep -oE '[0-9,]+ distinct states found' "$tmp/out" | tail -1 | cut -d' ' -f1 | tr -d ,; }
passed() { [ "$code" -eq 0 ] && grep -q "No error has been found" "$tmp/out"; }
reach() { # reach <dot> <rule> <want states> <label>
  node "$here/reach.mjs" "$1" "$2" >"$tmp/reach" 2>&1 || { cat "$tmp/reach" >&2; fail "$4 breaks $2"; }
  local seen
  seen=$(sed -n 's/.*every one of the \([0-9]*\) reachable states.*/\1/p' "$tmp/reach")
  [ "$seen" = "$3" ] || fail "$4: reach.mjs walked ${seen:-no} states, the checker found $3 (a truncated or misread graph)"
  cat "$tmp/reach"
}

# Every variant file is listed in expected.txt, and every listed variant has its file.
for d in "${variants[@]}"; do
  for f in "$here/$d"/*.tla; do
    [ -e "$f" ] || continue
    m=$(basename "$f" .tla)
    awk -v m="$m" '$2 == m { found = 1 } END { exit !found }' "$here/expected.txt" || fail "$d/$m.tla has no line in expected.txt (a variant nobody runs)"
    [ -e "$here/$d/$m.cfg" ] || fail "$d/$m.tla has no $m.cfg"
  done
done
while read -r kind module _; do
  case "$kind" in broken) d=broken ;; limit) d=limits ;; hole) d=holes ;; proposal) d=proposals ;; *) continue ;; esac
  [ -e "$here/$d/$module.tla" ] || fail "expected.txt names $kind $module but $d/$module.tla is missing"
done <"$here/expected.txt"

# 1, 2, 3: the real models (PlanLife = today's one-write code; StepsLife = the several-writes design)
models=(PlanLife StepsLife)
listed=$(awk '$1 == "model" { print $2 }' "$here/expected.txt" | sort)
[ "$listed" = "$(printf '%s\n' "${models[@]}" | sort)" ] || fail "expected.txt's model lines differ from the models check runs (${models[*]})"
stray=$(awk -v ms=" ${models[*]} " '($1 == "rule" || $1 == "states") && index(ms, " " $2 " ") == 0' "$here/expected.txt")
[ -z "$stray" ] || fail "expected.txt has rule / states lines for no model check runs: $stray"
reach_rule=""
for model in "${models[@]}"; do
  [ -e "$here/$model.tla" ] && [ -e "$here/$model.cfg" ] || fail "$model.tla or $model.cfg is missing"
  rules=$(sed -n 's/^INVARIANT //p' "$here/$model.cfg")
  r=$(sed -n 's/^\\\* REACH \([A-Za-z0-9_]*\) .*/\1/p' "$here/$model.cfg")
  [ -n "$r" ] || fail "$model.cfg has no \"\\* REACH\" line"
  [ -z "$reach_rule" ] || [ "$r" = "$reach_rule" ] || fail "$model.cfg names another REACH rule ($r, not $reach_rule)"
  reach_rule=$r
  ! grep -qE '^[[:space:]]*CHECK_DEADLOCK' "$here/$model.cfg" || fail "$model.cfg has a CHECK_DEADLOCK line (dead ends must stay checked)"
  have=$( (tr ' ' '\n' <<<"$rules"; echo "$reach_rule") | sed '/^$/d' | sort)
  need=$(awk -v m="$model" '$1 == "rule" && $2 == m { print $3 }' "$here/expected.txt" | sort)
  [ "$have" = "$need" ] || fail "the rules $model.cfg checks differ from expected.txt's rule lines for $model"
  run "$model" -dump dot,actionlabels "$tmp/graph.dot"
  passed || { show; fail "the real model $model breaks a rule or has a dead end (exit code ${code})"; }
  got=$(states_found)
  want=$(awk -v m="$model" '$1 == "states" && $2 == m { print $3 }' "$here/expected.txt")
  [ "$got" = "$want" ] || fail "the real model $model has $got distinct states, expected.txt says $want (changed the model? update expected.txt and say why in the PR)"
  echo "ok   real model $model: keeps all $(wc -w <<<"$rules" | tr -d ' ') INVARIANTs, no dead end, ${got} distinct states (as expected)"
  reach "$tmp/graph.dot" "$reach_rule" "$got" "the real model $model"
done

# 4, 5: broken variants, accepted limits and open holes must fail on their named rule
n=0
while read -r kind module rule; do
  case "$kind" in broken|limit|hole) ;; *) continue ;; esac
  n=$((n + 1))
  if [ "$rule" = "$reach_rule" ]; then
    run "$module" -dump dot,actionlabels "$tmp/b.dot"
    [ "$code" -eq 0 ] || { show; fail "$kind $module failed on an INVARIANT or a dead end (it must fail on $rule alone)"; }
    rc=0; node "$here/reach.mjs" "$tmp/b.dot" "$rule" >"$tmp/reach" 2>&1 || rc=$?
    { [ "$rc" -eq 1 ] && grep -q "^FAIL $rule:" "$tmp/reach"; } || { cat "$tmp/reach" >&2; fail "$kind $module does not fail $rule"; }
    echo "ok   $kind $module fails $rule ($(sed -n 's/^     actions: //p' "$tmp/reach"))"
  else
    run "$module"
    broke=$(violated)
    { [ "$code" -eq 12 ] && [ "$broke" = "$rule" ]; } || { show; fail "$kind $module does not fail on $rule (exit code ${code}, rule broken: ${broke:-none})"; }
    echo "ok   $kind $module fails $rule"
  fi
done <"$here/expected.txt"
[ "$n" -gt 0 ] || fail "expected.txt has no broken / limit / hole line"

# 6: proposed fixes keep every rule
while read -r kind module count; do
  [ "$kind" = proposal ] || continue
  run "$module" -dump dot,actionlabels "$tmp/p.dot"
  passed || { show; fail "proposal $module breaks a rule (exit code ${code})"; }
  got=$(states_found)
  [ "$got" = "$count" ] || fail "proposal $module has ${got} distinct states, expected.txt says ${count}"
  echo "ok   proposal $module keeps every INVARIANT (${got} distinct states)"
  reach "$tmp/p.dot" "$reach_rule" "$got" "proposal $module"
done <"$here/expected.txt"
echo "ok   model/browser-plan/check: all passed in $(( $(date +%s) - started )) s"
