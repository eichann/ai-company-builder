# The staging kit's front door (staging/compose.yml): one origin for the admin console, the
# API and git, like production behind Caddy. PUBLIC_URL is this address, so the server's
# auth trusts it without any change.
{
	admin off
	auto_https off
}

:8080 {
	handle /api/* {
		reverse_proxy api:3001 {
			flush_interval -1
		}
	}
	handle {
		reverse_proxy admin:3100
	}
}
