# =============================================================================
# AI Company Builder - Production Environment Variables
# =============================================================================
# Copy this file to .env and fill in the required values:
#   cp .env.example .env
#
# Generate AUTH_SECRET with:
#   openssl rand -hex 32
# =============================================================================

# ---------------------
#  Required Settings
# ---------------------

# Session signing secret (MUST be unique, minimum 32 characters)
# Generate with: openssl rand -hex 32
AUTH_SECRET=

# Your domain (with https://)
# Used for CORS, cookies, and the admin panel's API calls
PUBLIC_URL=https://your-domain.com

# Environment mode (enables secure cookies over HTTPS)
NODE_ENV=production

# ---------------------
#  Optional Settings
# ---------------------

# The api container runs as this uid/gid (never root); it must own ./data and
# the KEK file. Default 1000:1000. Set to `id -u` / `id -g` of the user that
# owns ./data if those differ (see README, step 2.3).
# ACB_UID=1000
# ACB_GID=1000

# API server port (default: 3001)
# PORT=3001

# Data directory for SQLite databases (default: ./data)
# DATA_DIR=./data

# Git repositories directory (default: ${DATA_DIR}/repos)
# REPOS_DIR=./data/repos

# ---------------------
#  Legacy SSH Settings (optional)
# ---------------------
# Only needed if you use the legacy SSH-based Git remotes.
# The default HTTPS Git sync does not require these.
# SERVER_HOST=
# SERVER_USER=
# HOST_REPOS_DIR=

# ---------------------
#  Key broker (optional)
# ---------------------
# Host path of the key-encryption key file for stored API keys. Keep it
# outside the checkout and outside ./data, owned by ACB_UID with mode 600, and
# keep a copy in a password manager. Unset = the key broker is off. See README.
# BROKER_KEK_HOST_FILE=/etc/acb/broker-kek
