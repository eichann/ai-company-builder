{
  "name": "@ai-company-builder/server",
  "version": "0.0.1",
  "description": "AI Company Builder API Server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.staging.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "fake:hubspot": "tsx tests/fakes/hubspot/serve.ts",
    "fake:google": "tsx tests/fakes/google/serve.ts",
    "fake:slack": "tsx tests/fakes/slack/serve.ts",
    "fake:portal": "tsx tests/fakes/portal/serve.ts",
    "manual:build": "tsx src/cli/build-manual.ts ../manual manual-site"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "better-auth": "1.7.14",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.5",
    "hono": "^4.13.13",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.12",
    "eslint": "^9.39.2",
    "globals": "^17.7.0",
    "rehype-sanitize": "^6",
    "rehype-slug": "^6",
    "rehype-stringify": "^10",
    "remark-gfm": "^4",
    "remark-parse": "^11",
    "remark-rehype": "^11",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.62.1",
    "unified": "^11",
    "vitest": "^5.1.1"
  }
}
