{
  "name": "@ai-company-builder/server",
  "version": "0.0.1",
  "description": "AI Company Builder API Server",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "fake:hubspot": "tsx tests/fakes/hubspot/serve.ts",
    "fake:google": "tsx tests/fakes/google/serve.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.17",
    "better-auth": "1.6.33",
    "better-sqlite3": "^12.11.1",
    "dotenv": "^16.4.5",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^20.14.12",
    "eslint": "^9.39.2",
    "globals": "^17.7.0",
    "tsx": "^4.23.15",
    "typescript": "^5.5.3",
    "typescript-eslint": "^8.62.1",
    "vitest": "^4.1.12"
  }
