{
  "name": "ai-company-builder",
  "version": "0.0.1",
  "private": true,
  "description": "AI Agent-driven workflow platform for companies",
  "scripts": {
    "dev": "pnpm --filter client dev",
    "dev:no-spellcheck": "ELECTRON_DISABLE_SPELLCHECK=1 pnpm --filter client dev",
    "dev:server": "pnpm --filter server dev",
    "dev:admin": "pnpm --filter admin dev",
    "fake:hubspot": "pnpm --filter server fake:hubspot",
    "staging:setup": "node staging/bootstrap.mjs setup",
    "staging:up": "node staging/bootstrap.mjs up",
    "staging:down": "node staging/bootstrap.mjs down",
    "staging:reset": "node staging/bootstrap.mjs reset",
    "staging:app": "node staging/bootstrap.mjs app",
    "staging:status": "node staging/bootstrap.mjs status",
    "staging:remove": "node staging/bootstrap.mjs remove",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck"
  },
  "keywords": ["ai", "agent", "electron", "workflow"],
  "author": "",
  "license": "AGPL-3.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "pnpm": {
    "overrides": {
      "@anthropic-ai/claude-agent-sdk": "0.3.304"
    },
    "packageExtensions": {
      "next@*": {
        "peerDependencies": { "@types/react": "*", "@types/react-dom": "*" },
        "peerDependenciesMeta": { "@types/react": { "optional": true }, "@types/react-dom": { "optional": true } }
      },
      "@phosphor-icons/react@*": {
        "peerDependencies": { "@types/react": "*" },
        "peerDependenciesMeta": { "@types/react": { "optional": true } }
      },
      "@dnd-kit/core@*": {
        "peerDependencies": { "@types/react": "*" },
        "peerDependenciesMeta": { "@types/react": { "optional": true } }
      },
      "@dnd-kit/sortable@*": {
        "peerDependencies": { "@types/react": "*" },
        "peerDependenciesMeta": { "@types/react": { "optional": true } }
      },
      "@dnd-kit/utilities@*": {
        "peerDependencies": { "@types/react": "*" },
        "peerDependenciesMeta": { "@types/react": { "optional": true } }
      },
      "cmdk@*": {
        "peerDependencies": { "@types/react": "*" },
        "peerDependenciesMeta": { "@types/react": { "optional": true } }
      },
      "next-themes@*": {
        "peerDependencies": { "@types/react": "*" },
        "peerDependenciesMeta": { "@types/react": { "optional": true } }
      },
      "react-i18next@*": {
        "peerDependencies": { "@types/react": "*" },
        "peerDependenciesMeta": { "@types/react": { "optional": true } }
      }
    }
  }
}
