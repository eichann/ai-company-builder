# AI Company Builder - Environment Variables
# Copy this file to .env and fill in the values:
#   cp .env.example .env

# ---------------------
#  Required Settings
# ---------------------

# Authentication secret (generate with: openssl rand -base64 32)
AUTH_SECRET=

# Public URL of this server (used for CORS, cookies, admin panel API)
# For local development, leave commented out (defaults to http://localhost:3001)
# For production, set to your domain:
# PUBLIC_URL=https://your-domain.com

# Environment (development or production)
# In production, secure cookies are enabled (requires HTTPS)
# NODE_ENV=production

# Host address Docker publishes ports on (default: 127.0.0.1 = this machine only)
# Keep the default unless you have a reason not to. Known exception:
# OrbStack (<= 2.2.0) fails to forward loopback-bound ports when host and
# container ports match (https://github.com/orbstack/orbstack/issues/944) —
# set 0.0.0.0 there as a workaround.
# BIND_ADDR=0.0.0.0

# ---------------------
#  Git Server Settings
# ---------------------

# The public IP or hostname of this server (for SSH Git URLs)
# SERVER_HOST=your-server-ip

# The OS user that runs the application
# SERVER_USER=deploy

# Absolute path to Git bare repositories on the host filesystem
# HOST_REPOS_DIR=/home/deploy/ai-company-builder/data/repos

# ---------------------
#  Key broker (optional)
# ---------------------

# The server can hold the company's API keys and hand the AI only short-lived
# tokens ("API キー" in the admin console). The keys are encrypted with a
# key-encryption key (KEK) kept in a file on the host. Without it the broker
# is simply off.
#
# 1. Create the KEK once, outside this checkout and outside ./data (database
#    backups must not contain it), owner-only:
#      sudo install -d -m 700 /etc/acb
#      docker compose run --rm --no-deps -v /etc/acb:/kek api \
#        node --import tsx src/cli/generate-broker-kek.ts /kek/broker-kek
# 2. Store a copy of the file's contents in a password manager (not on this
#    server). Losing it makes every stored key unreadable.
# 3. Point the api container at it and restart (docker compose up -d api):
# BROKER_KEK_HOST_FILE=/etc/acb/broker-kek
#
# Lifetime of the short-lived tokens the desktop app receives, in minutes
# (15-60, default 30).
# BROKER_TOKEN_TTL_MINUTES=30
#
# The relay (/api/broker/...): largest request body in MB (default 100) and
# how long to wait for the provider's answer in seconds (default 600).
# BROKER_MAX_REQUEST_MB=100
# BROKER_UPSTREAM_TIMEOUT_SECONDS=600
# A key registered or replaced is checked once with a free, read-only request
# to the provider (e.g. GET /v1/models). Set to off when this server cannot
# reach the internet (keys are then saved unchecked).
# BROKER_KEY_CHECK=on
# Where the daily caps' day begins, minutes east of UTC (default 540 = Japan).
# BROKER_DAY_UTC_OFFSET_MINUTES=540
